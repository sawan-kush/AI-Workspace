# Copy to .env — never commit the real file.
# Backend (server/index.js) only. Nothing here is exposed to the browser.
PORT=8787

# Where emails come from. "mock" = built-in sample inbox (Phase 1B testing).
# Phase 1C adds "n8n" (Gmail through your n8n workflow).
EMAIL_SOURCE=mock

# Optional: where your rules are saved (default: server/data/rules.json)
# RULES_FILE=

# Phase 1C: n8n connection (leave blank for now)
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# Phase 1D: AI model for summaries and reply drafts (leave blank for now)
AI_MODEL=