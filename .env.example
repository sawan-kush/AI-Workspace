PORT=8787

# mock = built-in sample inbox, n8n = your Gmail through n8n
EMAIL_SOURCE=mock

# Paste the Production URL from the n8n Webhook node here (it contains /webhook/)
N8N_WEBHOOK_URL=
# Paste the secret you generate with the command below
N8N_WEBHOOK_SECRET=
N8N_FETCH_LIMIT=100
N8N_CACHE_SECONDS=60

AI_MODEL=